{% assign locale = include.locale | default: site.locale %}
<nav class="nav__list">
  {% if page.sidebar.title %}<h3 class="nav__title" style="padding-left: 0;">{{ page.sidebar.title }}</h3>{% endif %}
  <input id="ac-toc" name="accordion-toc" type="checkbox" />
  <label for="ac-toc">{{ site.data.ui-text[locale].menu_label | default: "Toggle Menu" }}</label>
  <ul class="nav__items">
    {% for navname in include.nav %}
      {% assign navigation = site.data.navigation[navname] %}
      {% for nav in navigation %}
        {% if nav.children != null %}
          {% assign section_active = false %}
          {% if nav.url == page.url %}{% assign section_active = true %}{% endif %}
          {% for child in nav.children %}
            {% if child.url == page.url %}{% assign section_active = true %}{% endif %}
            {% for grandchild in child.children %}
              {% if grandchild.url == page.url %}{% assign section_active = true %}{% endif %}
            {% endfor %}
          {% endfor %}
          <li>
            <details class="nav__section"{% if section_active %} open{% endif %}>
              <summary>
                {% if nav.url %}
                  <a href="{{ nav.url | relative_url }}"><span class="nav__sub-title">{{ nav.title }}</span></a>
                {% else %}
                  <span class="nav__sub-title">{{ nav.title }}</span>
                {% endif %}
              </summary>
              <ul>
                {% for child in nav.children %}
                  {% if child.children %}
                    {% assign child_active = false %}
                    {% if child.url == page.url %}{% assign child_active = true %}{% endif %}
                    {% for grandchild in child.children %}
                      {% if grandchild.url == page.url %}{% assign child_active = true %}{% endif %}
                    {% endfor %}
                    <li>
                      <details class="nav__section nav__subsection"{% if child_active %} open{% endif %}>
                        <summary>
                          <a href="{{ child.url | relative_url }}"{% if child.url == page.url %} class="active"{% endif %}>{{ child.title }}</a>
                        </summary>
                        <ul class="nav__grandchildren">
                          {% for grandchild in child.children %}
                            <li><a href="{{ grandchild.url | relative_url }}"{% if grandchild.url == page.url %} class="active"{% endif %}>{{ grandchild.title }}</a></li>
                          {% endfor %}
                        </ul>
                      </details>
                    </li>
                  {% else %}
                    <li><a href="{{ child.url | relative_url }}"{% if child.url == page.url %} class="active"{% endif %}>{{ child.title }}</a></li>
                  {% endif %}
                {% endfor %}
              </ul>
            </details>
          </li>
        {% else %}
          <li>
            {% if nav.url %}
              <a href="{{ nav.url | relative_url }}"><span class="nav__sub-title">{{ nav.title }}</span></a>
            {% else %}
              <span class="nav__sub-title">{{ nav.title }}</span>
            {% endif %}
          </li>
        {% endif %}
      {% endfor %}
    {% endfor %}
  </ul>
</nav>
